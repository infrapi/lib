{{define "content"}}
<header>
  <h1>Cluster</h1>
</header>

{{if not .Enabled}}
<p class="notice">Clustering is turned off for this service: <code>INFRAPI_CLUSTER_ENABLED</code> is not set.</p>
{{else}}

<dl class="facts">
  <div><dt class="label">This replica</dt><dd>{{.InstanceID}}</dd></div>
  <div><dt class="label">Address</dt><dd>{{.InstanceHost}}</dd></div>
  <div><dt class="label">Store</dt><dd>{{.Store}}</dd></div>
  {{if .HasGossip}}
  <div><dt class="label">Cluster label</dt><dd>{{.ClusterLabel}}</dd></div>
  <div><dt class="label">Gossip port</dt><dd>{{.GossipPort}}</dd></div>
  {{end}}
</dl>

<section>
  <h2>Roles</h2>
  {{if not .Roles}}
  <p class="notice">This replica joined no role, so it coordinates nothing. It can still share state through the store.</p>
  {{else}}
  <div class="roles">
    {{range .Roles}}
    <div class="role">
      <h3>
        {{if $.Prefix}}<a href="{{$.Prefix}}/ring/{{.Name}}">{{.Name}}</a>{{else}}{{.Name}}{{end}}
        <span class="badge badge-mode">{{.Mode}}</span>
      </h3>
      {{if .Error}}
      <p class="notice notice-error">{{.Error}}</p>
      {{else}}
      <dl>
        <dt class="label">This replica</dt>
        <dd>{{if .ShouldRun}}<span class="badge badge-acting">acting</span>{{else}}<span class="badge badge-passive">passive</span>{{end}}</dd>
        <dt class="label">State</dt><dd>{{.State}}</dd>
        {{if eq .Mode "leader"}}
          <dt class="label">Leader</dt>
          <dd>
            {{if .Leader}}
              {{.Leader}}
              {{if .LeaderIsSelf}}<span class="badge badge-acting">this replica</span>
              {{else if .LeaderURL}}<a href="{{.LeaderURL}}">open</a>{{end}}
            {{else}}none{{end}}
          </dd>
          <dt class="label">May lead</dt>
          <dd>
            {{if .MayLead}}<span class="badge badge-active">yes</span>
            {{else}}<span class="badge badge-unhealthy">no</span> <span class="mono">{{.LeaderCheckFail}}</span>{{end}}
          </dd>
        {{end}}
        <dt class="label">Members</dt><dd>{{.MemberCount}}</dd>
        <dt class="label">Ring key</dt><dd>{{.Key}}</dd>
      </dl>
      {{end}}
    </div>
    {{end}}
  </div>
  {{end}}
</section>

{{if .HasGossip}}
<section>
  <h2>Gossip</h2>
  <ul class="links">
    <li><a href="{{.Prefix}}/memberlist">Gossip store</a>
      <span>mesh membership, key-value contents, message history</span></li>
  </ul>
</section>
{{end}}

{{end}}
{{end}}
