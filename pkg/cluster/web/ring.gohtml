{{define "content"}}
<header>
  <h1>{{.RoleName}}</h1>
  <span class="badge badge-mode">{{.Mode}}</span>
  {{if .Prefix}}<span class="crumbs"><a href="{{.Prefix}}">&larr; cluster</a></span>{{end}}
</header>

<dl class="facts">
  <div><dt class="label">Ring key</dt><dd>{{.Key}}</dd></div>
  {{if eq .Mode "leader"}}<div><dt class="label">Leader</dt><dd>{{if .Leader}}{{.Leader}}{{else}}none{{end}}</dd></div>{{end}}
  <div><dt class="label">This replica</dt><dd>{{.InstanceID}}</dd></div>
  <div><dt class="label">Heartbeat timeout</dt><dd>{{.HeartbeatTimeout}}</dd></div>
</dl>

{{if .Error}}
<p class="notice notice-error">{{.Error}}</p>
{{else}}
<section>
  <h2>Members</h2>
  {{if not .Members}}
  <p class="notice">The ring is empty.</p>
  {{else}}
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th>Instance</th><th>State</th><th>Health</th><th>Address</th>
          <th>Zone</th><th>Tokens</th><th>Last heartbeat</th><th>Registered</th>
        </tr>
      </thead>
      <tbody>
        {{range .Members}}
        <tr class="{{if eq .ID $.InstanceID}}self{{else if not .Healthy}}stale{{end}}">
          <td class="mono">{{.ID}}</td>
          <td><span class="badge badge-{{lower .State}}">{{.State}}</span></td>
          <td>{{if .Healthy}}<span class="badge badge-active">eligible</span>{{else}}<span class="badge badge-unhealthy">excluded</span>{{end}}</td>
          <td class="mono">{{.Addr}}</td>
          <td class="mono">{{if .Zone}}{{.Zone}}{{else}}&mdash;{{end}}</td>
          <td class="mono">{{len .Tokens}}</td>
          <td class="mono">{{ago .Heartbeat}}</td>
          <td class="mono">{{ago .RegisteredAt}}</td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  <p class="notice">Every registered replica is listed. <em>Excluded</em> means
    this role's coordination mode does not count it: its heartbeat is older than
    the timeout above, or its state is not one the mode accepts.</p>
  {{end}}

  {{if .ForgetEnabled}}
  <form class="forget" method="post">
    <span class="label">Forget a replica &mdash; removes it from the ring immediately</span>
    <input type="text" name="forget" placeholder="instance id" required>
    <button type="submit">Forget</button>
  </form>
  {{end}}
</section>
{{end}}
{{end}}
