{{- /*gotype: github.com/grafana/dskit/kv/memberlist.StatusPageData */ -}}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Gossip store</title>
<style>{{ template "cluster.css" }}</style>
</head>
<body>
<main>

<header>
  <h1>Gossip store</h1>
  {{ if clusterPath }}<span class="crumbs"><a href="{{ clusterPath }}">&larr; cluster</a></span>{{ end }}
</header>

{{ $score := .Memberlist.GetHealthScore }}
{{ if eq $score 0 }}
  <p class="notice notice-ok">Memberlist cluster has
    <strong>{{ .Memberlist.NumMembers }}</strong> member(s) and it is
    <strong>healthy</strong>.</p>
{{ else }}
  <p class="notice notice-error">Memberlist cluster has
    <strong>{{ .Memberlist.NumMembers }}</strong> member(s) but its health score
    is <strong>{{ $score }}</strong>. The score is this node's own count of
    recent failures to reach its peers: lower is better, and 0 is healthy.</p>
{{ end }}

{{ if .ZoneAwareRouting.Enabled }}
  <p class="notice">Zone-aware routing is enabled, so the zone and role columns
    below say which zone each node gossips for.</p>
{{ end }}

<section>
  <h2>Key-Value Store</h2>
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th>Key</th><th>Codec</th><th>Version</th><th>Size</th><th>View</th>
        </tr>
      </thead>
      <tbody>
      {{ range $key, $value := .Store }}
        <tr>
          <td class="mono">{{ $key }}</td>
          <td class="mono">{{ $value.CodecID }}</td>
          <td class="mono">{{ $value.Version }}</td>
          <td class="mono">{{ index $.StoreSizes $key }} B</td>
          <td class="mono">
            <a href="?viewKey={{ $key }}&format=json-pretty">json</a>
            &middot; <a href="?viewKey={{ $key }}&format=struct">struct</a>
            &middot; <a href="?downloadKey={{ $key }}">download</a>
          </td>
        </tr>
      {{ else }}
        <tr><td colspan="5">The store is empty.</td></tr>
      {{ end }}
      </tbody>
    </table>
  </div>
  <p class="notice">A version is node-local: it starts at 0 on restart and
    increases on every update this node receives, so two replicas disagreeing on
    it is normal. Size is the encoded size in bytes.</p>
  <p class="notice">A deleted key is still listed until
    <code>INFRAPI_CLUSTER_OBSOLETE_ENTRIES_TIMEOUT</code> has passed, so that a
    peer which has not heard about the deletion cannot revive it. Its
    <em>struct</em> view carries the flag.</p>
</section>

<section>
  <h2>Cluster Members</h2>
  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th>Name</th><th>Address</th><th>State</th>
          {{ if .ZoneAwareRouting.Enabled }}<th>Zone</th><th>Role</th>{{ end }}
        </tr>
      </thead>
      <tbody>
      {{ range .SortedMembers }}
        <tr>
          <td class="mono">{{ .Name }}</td>
          <td class="mono">{{ .Address }}</td>
          <td><span class="badge {{ nodeStateClass .State }}">{{ nodeState .State }}</span></td>
          {{ if $.ZoneAwareRouting.Enabled }}
            <td class="mono">{{ GetZoneFromMeta .Meta }}</td>
            <td class="mono">{{ GetRoleFromMeta .Meta }}</td>
          {{ end }}
        </tr>
      {{ else }}
        <tr><td colspan="5">No members.</td></tr>
      {{ end }}
      </tbody>
    </table>
  </div>
  <p class="notice">This is the gossip membership, which is not the same thing as
    a ring: a node is listed here as soon as it joined the mesh, whatever role
    rings it did or did not register in.</p>
</section>

<section>
  <h2>Message History</h2>
  {{ if .MessageHistoryBufferBytes }}
    {{ template "messages" messages "Received" .ReceivedMessages }}
    {{ template "messages" messages "Sent" .SentMessages }}
    <form class="forget" method="get">
      <span class="label">Clear the history &mdash; received and sent</span>
      <input type="hidden" name="deleteMessages" value="true">
      <button type="submit">Delete all messages</button>
    </form>
  {{ else }}
    <p class="notice">Message history buffer is disabled. Enable it by setting
      <code>INFRAPI_CLUSTER_MESSAGE_HISTORY_BUFFER_BYTES</code> &mdash; dskit's
      <code>-memberlist.message-history-buffer-bytes</code>, configured here
      through the dotenv. It buffers every message in memory, so turn it off
      again afterwards.</p>
  {{ end }}
</section>

<footer>infrapi/lib cluster &middot; rendered {{ .Now.Format "2006-01-02 15:04:05 MST" }}</footer>
</main>
</body>
</html>

{{ define "messages" }}
<h3>{{ .Title }}</h3>
<div class="scroll">
  <table>
    <thead>
      <tr>
        <th>ID</th><th>Time</th><th>Key</th><th>Payload</th>
        <th>Version</th><th>Changes</th><th>View</th>
      </tr>
    </thead>
    <tbody>
    {{ range .Messages }}
      <tr>
        <td class="mono">{{ .ID }}</td>
        <td class="mono">{{ .Time.Format "15:04:05.000" }}</td>
        <td class="mono">{{ .Pair.Key }}</td>
        <td class="mono">{{ len .Pair.Value }} B, {{ .Pair.Codec }}</td>
        <td class="mono">{{ .Version }}</td>
        <td>{{ StringsJoin .Changes ", " }}</td>
        <td class="mono">
          <a href="?viewMsg={{ .ID }}&format=json-pretty">json</a>
          &middot; <a href="?viewMsg={{ .ID }}&format=struct">struct</a>
        </td>
      </tr>
    {{ else }}
      <tr><td colspan="7">Nothing recorded yet.</td></tr>
    {{ end }}
    </tbody>
  </table>
</div>
{{ end }}
