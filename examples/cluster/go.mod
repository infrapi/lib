// This example lives in a module of its own for the same reason pkg/cluster
// does: examples/ belongs to the root module, so an example importing the
// cluster package would pull dskit, grpc, etcd and otel into the library every
// InfraPI service depends on.
replace github.com/infrapi/lib => ../..

replace github.com/infrapi/lib/pkg/cluster => ../../pkg/cluster

// Repeated from dskit's own go.mod: a replace in a non-main module is ignored,
// and without this dskit's gossip store does not compile.
replace github.com/hashicorp/memberlist => github.com/grafana/memberlist v0.3.1-0.20260921102813-8c522db348af
