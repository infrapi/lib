INFRAPI_APP_NAME="example-cluster-node"
INFRAPI_APP_PLATFORM="sandbox"
INFRAPI_APP_REGION="eu-west-1"
INFRAPI_APP_LOCATION="dc2"
INFRAPI_APP_FQDN="node-2.local.example.com"
INFRAPI_APP_URL="http://node-2.local.example.com:8080"
INFRAPI_APP_LISTEN_TYPE="tcp"

# Each replica has an address of its own, so both can use the same ports — the
# shape of a real deployment, where replicas differ by host and not by port.
# The whole of 127.0.0.0/8 is local on Linux; on macOS 127.0.0.2 needs
# `sudo ifconfig lo0 alias 127.0.0.2` first.
INFRAPI_APP_LISTEN_ADDRESS="127.0.0.2:8080"
INFRAPI_APP_LOG_LEVEL="info"
INFRAPI_APP_TRUSTED_PROXIES=[]

INFRAPI_CLUSTER_ENABLED="true"
INFRAPI_CLUSTER_KV_STORE="memberlist"
INFRAPI_CLUSTER_ROLES=["scheduler","collector"]

INFRAPI_CLUSTER_INSTANCE_ID="node-2"

# The address this replica advertises in its rings is where peers reach its
# API, so it has to match the listen address above: that is what makes the
# leader link on the status page work. It is not the gossip address below.
INFRAPI_CLUSTER_INSTANCE_ADDR="127.0.0.2"
INFRAPI_CLUSTER_INSTANCE_PORT="8080"

INFRAPI_CLUSTER_GOSSIP_BIND_ADDRS=["127.0.0.2"]
INFRAPI_CLUSTER_GOSSIP_BIND_PORT="7946"

# The only lines that differ beyond the identity and the address: node-2 seeds
# off node-1, and refuses to start rather than quietly forming a cluster of one.
INFRAPI_CLUSTER_JOIN_MEMBERS=["127.0.0.1:7946"]
INFRAPI_CLUSTER_ABORT_IF_JOIN_FAILS="true"

# Short enough to watch an election and a failover happen. A real deployment
# leaves these alone.
INFRAPI_CLUSTER_HEARTBEAT_PERIOD="1s"
INFRAPI_CLUSTER_HEARTBEAT_TIMEOUT="5s"
INFRAPI_CLUSTER_AUTO_FORGET_UNHEALTHY_PERIODS="2"
INFRAPI_CLUSTER_LEAVE_TIMEOUT="2s"
INFRAPI_CLUSTER_BROADCAST_TIMEOUT_ON_SHUTDOWN="2s"
INFRAPI_CLUSTER_STOP_TIMEOUT="30s"

# Off, like the default. It keeps every message this node sends and receives in
# memory, so it is something to switch on while troubleshooting and switch back
# off, not a standing setting.
#INFRAPI_CLUSTER_MESSAGE_HISTORY_BUFFER_BYTES="1048576"
