INFRAPI_APP_NAME="example-cluster-kvapi"
INFRAPI_APP_PLATFORM="sandbox"
INFRAPI_APP_REGION="eu-west-1"
INFRAPI_APP_LOCATION="dc1"
INFRAPI_APP_FQDN="node-2.local.example.com"
INFRAPI_APP_URL="http://node-2.local.example.com:8085"
INFRAPI_APP_LISTEN_TYPE="tcp"
INFRAPI_APP_LISTEN_ADDRESS="127.0.0.2:8085"
INFRAPI_APP_LOG_LEVEL="info"
INFRAPI_APP_TRUSTED_PROXIES=[]

INFRAPI_CLUSTER_ENABLED="true"
INFRAPI_CLUSTER_ROLES=["api"]

INFRAPI_CLUSTER_INSTANCE_ID="node-2"
INFRAPI_CLUSTER_INSTANCE_ADDR="127.0.0.2"
INFRAPI_CLUSTER_INSTANCE_PORT="8085"

INFRAPI_CLUSTER_HEARTBEAT_PERIOD="1s"
INFRAPI_CLUSTER_HEARTBEAT_TIMEOUT="5s"
INFRAPI_CLUSTER_AUTO_FORGET_UNHEALTHY_PERIODS="2"
INFRAPI_CLUSTER_START_TIMEOUT="20s"
INFRAPI_CLUSTER_STOP_TIMEOUT="20s"

# ---- the one block that differs between these files
# Seeds off node-1, and refuses to start rather than quietly forming a cluster
# of one.
INFRAPI_CLUSTER_KV_STORE="memberlist"
INFRAPI_CLUSTER_GOSSIP_BIND_ADDRS=["127.0.0.2"]
INFRAPI_CLUSTER_GOSSIP_BIND_PORT="7946"
INFRAPI_CLUSTER_JOIN_MEMBERS=["127.0.0.1:7946"]
INFRAPI_CLUSTER_ABORT_IF_JOIN_FAILS="true"
INFRAPI_CLUSTER_LEAVE_TIMEOUT="2s"
INFRAPI_CLUSTER_BROADCAST_TIMEOUT_ON_SHUTDOWN="2s"
