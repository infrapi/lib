INFRAPI_APP_NAME="example-cluster-zones"
INFRAPI_APP_PLATFORM="sandbox"
INFRAPI_APP_REGION="eu-west-1"
INFRAPI_APP_LOCATION="dc2"
INFRAPI_APP_FQDN="dc2-member.local.example.com"
INFRAPI_APP_URL="http://dc2-member.local.example.com:8080"
INFRAPI_APP_LISTEN_TYPE="tcp"

# One address per replica, so all four can serve on the same port. The whole of
# 127.0.0.0/8 is local on Linux; on macOS each alias beyond 127.0.0.1 needs
# `sudo ifconfig lo0 alias <address>` first.
INFRAPI_APP_LISTEN_ADDRESS="127.0.0.4:8080"
INFRAPI_APP_LOG_LEVEL="info"
INFRAPI_APP_TRUSTED_PROXIES=[]

INFRAPI_CLUSTER_ENABLED="true"
INFRAPI_CLUSTER_KV_STORE="memberlist"
INFRAPI_CLUSTER_ROLES=["scheduler"]

INFRAPI_CLUSTER_INSTANCE_ID="dc2-member"
INFRAPI_CLUSTER_INSTANCE_ADDR="127.0.0.4"
INFRAPI_CLUSTER_INSTANCE_PORT="8080"

INFRAPI_CLUSTER_GOSSIP_BIND_ADDRS=["127.0.0.4"]
INFRAPI_CLUSTER_GOSSIP_BIND_PORT="7946"

# One mesh for every zone: the label is what makes it one cluster. Give each
# zone a different label instead, and you get independent clusters with a
# leader each — a different deployment, not a different setting.
INFRAPI_CLUSTER_GOSSIP_CLUSTER_LABEL="example-zones"

# Gossip stays inside a zone. A member selects only peers in its own zone; a
# bridge selects its own zone plus the bridges of other zones. A zone with no
# live bridge stops exchanging state with the rest of the cluster.
INFRAPI_CLUSTER_GOSSIP_ZONE_AWARE_ROUTING_ENABLED="true"
INFRAPI_CLUSTER_ZONE="dc2"
INFRAPI_CLUSTER_GOSSIP_ZONE_ROLE="member"

# Seeds across zones on purpose, so that this replica can join even when dc2
# has no bridge running. That is what makes the split-brain experiment in the
# README possible: it joins, then quietly stops hearing from anyone.
INFRAPI_CLUSTER_JOIN_MEMBERS=["127.0.0.1:7946"]
INFRAPI_CLUSTER_ABORT_IF_JOIN_FAILS="true"

# Short enough to watch an election happen.
INFRAPI_CLUSTER_HEARTBEAT_PERIOD="1s"
INFRAPI_CLUSTER_HEARTBEAT_TIMEOUT="5s"
INFRAPI_CLUSTER_AUTO_FORGET_UNHEALTHY_PERIODS="2"
INFRAPI_CLUSTER_LEAVE_TIMEOUT="2s"
INFRAPI_CLUSTER_BROADCAST_TIMEOUT_ON_SHUTDOWN="2s"
INFRAPI_CLUSTER_STOP_TIMEOUT="30s"
