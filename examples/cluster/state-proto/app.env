INFRAPI_APP_NAME="example-cluster-state-proto"
INFRAPI_APP_PLATFORM="sandbox"
INFRAPI_APP_REGION="eu-west-1"
INFRAPI_APP_LOCATION="dc1"
INFRAPI_APP_FQDN="example-cluster.local.example.com"
INFRAPI_APP_URL="http://example-cluster.local.example.com:8083"
INFRAPI_APP_LISTEN_TYPE="tcp"
INFRAPI_APP_LISTEN_ADDRESS="127.0.0.1:8083"
INFRAPI_APP_LOG_LEVEL="error"
INFRAPI_APP_TRUSTED_PROXIES=[]

INFRAPI_CLUSTER_ENABLED="true"

# The gossip store on purpose: it is the one that requires Mergeable, so it is
# the one that exercises the type next door. An ephemeral port and no peers keep
# the example runnable anywhere.
INFRAPI_CLUSTER_KV_STORE="memberlist"
INFRAPI_CLUSTER_GOSSIP_BIND_ADDRS=["127.0.0.1"]
INFRAPI_CLUSTER_GOSSIP_BIND_PORT="0"

INFRAPI_CLUSTER_INSTANCE_ID="replica-1"
INFRAPI_CLUSTER_INSTANCE_ADDR="127.0.0.1"
INFRAPI_CLUSTER_INSTANCE_PORT="8083"

# No role: this example wants the shared store and no coordination.
INFRAPI_CLUSTER_ROLES=[]

INFRAPI_CLUSTER_HEARTBEAT_PERIOD="200ms"
INFRAPI_CLUSTER_HEARTBEAT_TIMEOUT="2s"
INFRAPI_CLUSTER_AUTO_FORGET_UNHEALTHY_PERIODS="2"
INFRAPI_CLUSTER_START_TIMEOUT="15s"
INFRAPI_CLUSTER_LEAVE_TIMEOUT="1s"
INFRAPI_CLUSTER_BROADCAST_TIMEOUT_ON_SHUTDOWN="1s"
INFRAPI_CLUSTER_STOP_TIMEOUT="15s"

# Tombstones are kept this long so a peer that has not heard about a deletion
# cannot gossip the entry back. Short here so the example can show them expire.
INFRAPI_CLUSTER_OBSOLETE_ENTRIES_TIMEOUT="2s"
