INFRAPI_APP_NAME="example-cluster-roles"
INFRAPI_APP_PLATFORM="sandbox"
INFRAPI_APP_REGION="eu-west-1"
INFRAPI_APP_LOCATION="dc1"
INFRAPI_APP_FQDN="example-cluster.local.example.com"
INFRAPI_APP_URL="http://example-cluster.local.example.com:8080"
INFRAPI_APP_LISTEN_TYPE="tcp"
INFRAPI_APP_LISTEN_ADDRESS="127.0.0.1:8080"
INFRAPI_APP_LOG_LEVEL="error"
INFRAPI_APP_TRUSTED_PROXIES=[]

INFRAPI_CLUSTER_ENABLED="true"

# The in-memory store keeps this example runnable anywhere: no socket, no peer.
# See ../node for a real gossip cluster.
INFRAPI_CLUSTER_KV_STORE="inmemory"
INFRAPI_CLUSTER_INSTANCE_ID="replica-1"
INFRAPI_CLUSTER_INSTANCE_ADDR="127.0.0.1"
INFRAPI_CLUSTER_INSTANCE_PORT="7946"

# Short enough that the example finishes while you watch it.
INFRAPI_CLUSTER_HEARTBEAT_PERIOD="200ms"
INFRAPI_CLUSTER_HEARTBEAT_TIMEOUT="2s"
INFRAPI_CLUSTER_AUTO_FORGET_UNHEALTHY_PERIODS="2"
INFRAPI_CLUSTER_START_TIMEOUT="10s"
INFRAPI_CLUSTER_STOP_TIMEOUT="10s"

INFRAPI_CLUSTER_ROLES=["scheduler","collector"]

