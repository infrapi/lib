# Custom configuration with modified validators
# This demonstrates using custom region and platform values

INFRAPI_APP_NAME="custom-app"

# Using custom region validator: "emea" or "apac"
# (Default validator uses: eu-west-1, eu-west-2, au-southeast-1)
INFRAPI_APP_REGION="emea"

# Using custom platform validator: "development", "staging", or "production"
# (Default validator uses: sandbox, preprod, prod)
INFRAPI_APP_PLATFORM="development"

# Other required fields
INFRAPI_APP_LOCATION="dc1"
INFRAPI_APP_URL="http://localhost:8080"
