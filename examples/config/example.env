# InfraPi Application Configuration Example
# This file demonstrates all available configuration options

# Application name (required)
INFRAPI_APP_NAME="example-app"

# Log level (default: info)
# Options: trace, debug, info, error
INFRAPI_APP_LOG_LEVEL="debug"

# Listen type (default: tcp)
# Options: tcp, systemd
INFRAPI_APP_LISTEN_TYPE="tcp"

# Listen address (default: 127.0.0.1:8080)
# Format: hostname:port
INFRAPI_APP_LISTEN_ADDRESS="0.0.0.0:8080"

# Platform (required)
# Options: sandbox, preprod, prod
INFRAPI_APP_PLATFORM="sandbox"

# Region (required)
# Options: eu-west-1, eu-west-2, au-southeast-1
INFRAPI_APP_REGION="eu-west-1"

# Location (required)
# Options: dc1, dc2, dc3
INFRAPI_APP_LOCATION="dc1"

# Fully qualified domain name (default: hostname)
INFRAPI_APP_FQDN="example.infrapi.io"

# Application URL (required)
INFRAPI_APP_URL="http://example.infrapi.io:8080"

# Trusted proxies (default: [])
# Format: JSON array of IP addresses
INFRAPI_APP_TRUSTED_PROXIES=["10.0.0.1", "192.168.1.1"]

# CORS configuration

# CORS Allow Origins (default: ["*"])
INFRAPI_APP_CORS_ALLOW_ORIGINS=["http://localhost:3000", "https://example.com"]

# CORS Allow Methods (default: ["PUT", "PATCH", "HEAD"])
INFRAPI_APP_CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]

# CORS Allow Headers (default: ["Origin"])
INFRAPI_APP_CORS_ALLOW_HEADERS=["Content-Type", "Authorization", "X-Requested-With"]

# CORS Expose Headers (default: ["Content-Length"])
INFRAPI_APP_CORS_EXPOSE_HEADERS=["Content-Length", "X-Total-Count"]

# CORS Allow Credentials (default: true)
INFRAPI_APP_CORS_ALLOW_CREDENTIALS="true"

# CORS Max Age in hours (default: 12)
INFRAPI_APP_CORS_MAX_AGE="24"
